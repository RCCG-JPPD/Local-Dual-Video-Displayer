{
  "name": "unified-display-controller",
  "version": "2.0.0",
  "description": "Unified cross-platform multi-display video player with clock display and real-time previews",
  "main": "src/main.js",
  "homepage": "./",
  "author": "RCCG-JPPD",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --debug",
    "test": "node --test",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -mw"
  },
  "build": {
    "appId": "com.rccg.display-controller",
    "productName": "RCCG Display Controller",
    "files": [
      "src/**/*",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RCCG-JPPD",
        "repo": "Local-Dual-Video-Displayer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RCCG Display Controller"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^24.0.0",
    "pdfjs-dist": "^3.11.174"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
